# ============================================================
# .env - Environment Variables for Social Media Outreach Bot
# ============================================================

# OpenAI API Key (required for message generation with gpt-4o-mini)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Headless mode (true = no browser window, for VPS deployment)
# Set to "true" on VPS, leave "false" for local testing with visible browser
HEADLESS=false

# ============================================================
# DO NOT commit this file to Git. Add .env to your .gitignore
# ============================================================
